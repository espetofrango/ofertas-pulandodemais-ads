      <div class="container">
        <div class="section-header">
          <span class="section-number">01</span>
          <div>
            <h2 class="section-title">PACOTES PRINCIPAIS & COMBOS MECÂNICOS</h2>
            <p class="section-desc">Opções ideais para grande fluxo de crianças com brinquedos mecânicos e infláveis clássicos.</p>
          </div>
        </div>

        <div class="grid-cards">
          {pacotesPrincipais.map((p) => (
            <div class="card package-card" id={p.id}>
              <div class="card-header">
                <div class="card-title-row">
                  <h3 class="card-title">{p.titulo}</h3>
                  <span class="tag-badge">{p.tag}</span>
                </div>
                <div class="vehicle-badge">
                  <span class="vehicle-icon">{p.veiculoIcon}</span>
                  <span>Veículo: <strong>{p.veiculo}</strong></span>
                </div>
              </div>

              <div class="card-body">
                <h4 class="items-heading">Atrações Inclusas:</h4>
                <ul class="items-list">
                  {p.itens.map((item) => (
                    <li>
                      <span class="check-icon">✓</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>

                <!-- Bloco de Preços (Com 10% de Desconto no PIX) -->
                <div class="pricing-block">
                  <div class="pix-price-box">
                    <div class="pix-top-row">
                      <span class="pix-tag">⚡ 10% DE DESCONTO NO PIX</span>
                      <span class="economy-tag">Economia de {p.economiaPix}</span>
                    </div>
                    <div class="pix-amount">{p.precoPix} <span class="pix-sub">à vista</span></div>
                  </div>
                  <div class="card-price-box">
                    <div class="card-installment">ou <strong>10x de {p.parcelaCartao}</strong> sem juros</div>
                    <div class="card-total-note">no cartão de crédito (Total {p.precoCartao})</div>
                  </div>
                </div>
              </div>

              <div class="card-footer">
                <a
                  href={getWaLink(`${p.titulo} (${p.tag}) - PIX: ${p.precoPix} ou 10x de ${p.parcelaCartao}`)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-cta"
                >
                  <svg viewBox="0 0 24 24" class="btn-wa-icon" xmlns="http://www.w3.org/2000/svg">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                  <span>RESERVAR NO WHATSAPP</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

