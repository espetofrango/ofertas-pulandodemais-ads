<Layout
  title="Pacotes Dia das Crianças 2026 — Pulando Demais | Aluguel de Brinquedos"
  description="Tabela Oficial de Pacotes de Locação para o Dia das Crianças (12 de Outubro 2026). Valores em até 10x sem juros no cartão ou 10% de desconto no PIX à vista!"
>
  <!-- Top Bar Banner -->
  <div class="top-announcement">
    <span>🎈 ESPECIAL DIA DAS CRIANÇAS 2026 — PAGAMENTO EM ATÉ 10X SEM JUROS OU 10% OFF NO PIX! 🎁</span>
  </div>

  <header class="header">
    <div class="container header-container">
      <a href="/" class="header-logo-link" aria-label="Voltar para a página inicial">
        <img src="/logo.jpg" alt="Logo Pulando Demais" class="header-logo" width="160" height="60" />
      </a>
      <div class="header-date-badge">
        <span class="badge-day">12 DE OUTUBRO</span>
        <span class="badge-label">Dia das Crianças 2026</span>
      </div>
    </div>
  </header>

  <main class="page-content">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="container hero-container">
        <div class="hero-badge">
          <span>📋 TABELA OFICIAL DE PACOTES DE LOCAÇÃO</span>
        </div>
        <h1 class="hero-title">
          Aluguel de Brinquedos para o <span class="highlight">Dia das Crianças</span>
        </h1>
        <p class="hero-subtitle">
          Garanta a festa perfeita no dia 12 de Outubro de 2026! Todos os pacotes em até <strong>10x Sem Juros no Cartão</strong> ou com <strong>10% de Desconto no PIX</strong> à vista.
        </p>

        <!-- Banner de Condições de Pagamento -->
        <div class="payment-highlight-banner">
          <div class="pay-item">
            <span class="pay-icon">💳</span>
            <div>
              <strong>Em até 10x Sem Juros</strong>
              <p>Facilidade e parcelas iguais no cartão</p>
            </div>
          </div>
          <div class="pay-divider"></div>
          <div class="pay-item">
            <span class="pay-icon">⚡</span>
            <div>
              <strong>10% de Desconto no PIX</strong>
              <p>Economia garantida para pagamento à vista</p>
            </div>
          </div>
        </div>

        <!-- Banner Política Operacional Especial -->
        <div class="policy-banner">
          <div class="policy-icon">📌</div>
          <div class="policy-text">
            <strong>Política Operacional Especial:</strong> Para garantir excelência nas entregas e logística pontual no Dia das Crianças, as locações são fechadas exclusivamente em pacotes fechados por veículo de transporte.
          </div>
        </div>
      </div>
    </section>

    <!-- CTA URGÊNCIA NO TOPO -->
    <section class="cta-top-section">
      <div class="container">
        <div class="cta-top-box">
          <div class="cta-top-urgency">
            <span class="urgency-pulse"></span>
            <span class="urgency-text">⚠️ VAGAS LIMITADAS — 12 DE OUTUBRO</span>
          </div>
          <h2 class="cta-top-title">Garanta Já o Seu Pacote para o Dia das Crianças!</h2>
          <p class="cta-top-desc">
            A procura é altíssima e a disponibilidade da frota é limitada. Não deixe para a última hora — reserve agora pelo WhatsApp e escolha o melhor pacote para o seu evento!
          </p>
          <a
            href="https://wa.me/5521964370625?text=Ol%C3%A1!%20Gostaria%20de%20garantir%20j%C3%A1%20minha%20reserva%20para%20o%20Dia%20das%20Crian%C3%A7as%202026!%20Podem%20me%20ajudar%20a%20escolher%20o%20melhor%20pacote%3F"
            target="_blank"
            rel="noopener noreferrer"
            class="cta-top-btn"
          >
            🚀 GARANTIR MINHA RESERVA AGORA
          </a>
          <div class="cta-top-trust">
            <span>✓ Resposta imediata</span>
            <span>✓ Entrega e montagem inclusos</span>
            <span>✓ 10x sem juros ou 10% OFF no PIX</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Seção 01: Pacotes Principais & Combos Mecânicos -->
